{
  "name": "kbiz360-quin-aliza-backend",
  "version": "1.0.0",
  "private": true,
  "description": "KBiz360 Smart Trade ERP — REST API backend for Quin Aliza Group (Node.js, Express, MongoDB).",
  "type": "module",
  "main": "src/server.js",
  "engines": {
    "node": ">=20.11"
  },
  "scripts": {
    "dev": "node --watch src/server.js",
    "start": "node src/server.js",
    "test": "node --test \"tests/**/*.test.js\"",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "seed": "node scripts/seed.js",
    "seed:demo": "node scripts/seed.js --demo"
  },
  "imports": {
    "#config/*": "./src/config/*",
    "#modules/*": "./src/modules/*",
    "#shared/*": "./src/shared/*",
    "#routes/*": "./src/routes/*",
    "#scripts/*": "./scripts/*"
  },
  "dependencies": {
    "bcryptjs": "^3.0.3",
    "cors": "^2.8.6",
    "dotenv": "^18.0.9",
    "express": "^5.3.0",
    "express-rate-limit": "^8.7.2",
    "helmet": "^8.3.0",
    "jsonwebtoken": "^9.0.3",
    "mongoose": "^9.11.4",
    "pino": "^10.4.0",
    "pino-http": "^11.0.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.14.0",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^17.14.0",
    "pino-pretty": "^13.2.0",
    "prettier": "^3.9.10",
    "supertest": "^7.3.1"
  }
}
