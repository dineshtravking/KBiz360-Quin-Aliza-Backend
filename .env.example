# Copy this file to .env and fill in real values. Never commit .env.

# development | test | production
NODE_ENV=development
PORT=5000
API_PREFIX=/api/v1

# Local:  mongodb://127.0.0.1:27017/kbiz360_quin_aliza
# Atlas:  mongodb+srv://<user>:<password>@<cluster>.mongodb.net/kbiz360_quin_aliza
# Note: multi-document transactions need a replica set (Atlas has one by default).
MONGODB_URI=mongodb://127.0.0.1:27017/kbiz360_quin_aliza

# Comma-separated frontend origins allowed to call the API (Vite dev server is 5173)
CORS_ORIGIN=http://localhost:5173

# fatal | error | warn | info | debug | trace | silent
LOG_LEVEL=info

# Max requests per IP in each window
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=300
# Max login attempts per IP in each window
LOGIN_RATE_LIMIT_MAX=10

# Login tokens. Generate a secret with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=change-me-to-a-long-random-secret-of-at-least-32-chars
JWT_EXPIRES_IN=8h
# Password hashing cost (12 is a good default; tests use 4 for speed)
BCRYPT_ROUNDS=12

# Business dates ("today", voucher periods) use this time zone
BUSINESS_TIMEZONE=Africa/Lubumbashi

# Used only by `npm run seed` to create the first Super Admin.
# If the password is empty, a random one is generated and printed once.
SEED_ADMIN_EMAIL=afshin.dhanani@kingsgroupco.com
SEED_ADMIN_PASSWORD=
